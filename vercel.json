{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tapebackup.org"
        }
      ],
      "destination": "https://tapebackup.org/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/tape-q-and-a",
      "permanent": true
    },
    {
      "source": "/qa",
      "destination": "/tape-q-and-a",
      "permanent": true
    },
    {
      "source": "/questions",
      "destination": "/tape-q-and-a",
      "permanent": true
    },
    {
      "source": "/tape-q-and-a.html",
      "destination": "/tape-q-and-a",
      "permanent": true
    },
    {
      "source": "/lto-tape-price-inquiry",
      "destination": "/lto-tape-price-trend",
      "permanent": true
    },
    {
      "source": "/lto-tape-price-trend/drive-price",
      "destination": "/lto-tape-price-trend#summary",
      "permanent": true
    },
    {
      "source": "/lto-tape-price-trend/lto:gen(\\d+)",
      "destination": "/lto-tape-price-trend/lto:gen-price",
      "permanent": true
    },
    {
      "source": "/lto:gen(\\d+)-price",
      "destination": "/lto-tape-price-trend/lto:gen-price",
      "permanent": true
    },
    {
      "source": "/lto:gen(\\d+)-price.html",
      "destination": "/lto-tape-price-trend/lto:gen-price",
      "permanent": true
    },
    {
      "source": "/tape-backup-calculator",
      "destination": "/backup-calculator",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/about",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
